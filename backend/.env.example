# Database
DATABASE_URL=              # Supabase Transaction pooler URI (production) or sqlite:///./app.db (development)

# CORS
FRONTEND_URL=              # フロントエンドのURL（例: http://localhost:3000）

# freee API
FREEE_CLIENT_ID=           # freee アプリのクライアントID
FREEE_CLIENT_SECRET=       # freee アプリのクライアントシークレット
FREEE_REDIRECT_URI=        # OAuthコールバックURI（例: http://localhost:8000/auth/freee/callback）
FREEE_COMPANY_ID=          # freee 事業所ID

# Slack
SLACK_WEBHOOK_URL=         # Slack Incoming Webhook URL

# Batch
BATCH_SECRET_KEY=          # バッチ実行時の認証キー

# Google OAuth
GOOGLE_CLIENT_ID=          # Google Cloud Console の OAuth クライアントID
GOOGLE_CLIENT_SECRET=      # Google Cloud Console の OAuth クライアントシークレット

# App
ENVIRONMENT=               # 環境識別子（production / development）
